# PRODUCTION frontend build arguments. Copy to /opt/astar-erp/fe-build.env on the FE
# server (guide §8). release.sh passes each line to `docker build --build-arg`.
# The SDK key is publishable (visible in the page), not a secret.

# DWS Hub SDK from the PRODUCTION Hub: Hub Admin -> Applications -> AASTAR Logistic (Export) -> SDK.
VITE_HUB_SDK_KEY=FILL_DWSK_KEY
VITE_HUB_SDK_URL=https://dwshub.kpndomain.com
