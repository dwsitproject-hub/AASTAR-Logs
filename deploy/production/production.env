# PRODUCTION backend settings, non-secret. Copy to /opt/astar-erp/production.env
# (guide §7) and adjust; secrets go in secrets.production.env.
# Lines here are read by the container as is: no quotes, no spaces around "=".

# --- Address ---
# Exactly the address users open (no trailing slash): CORS / WebSocket origin.
# Day one (by IP); switch to http://aastar-logistic.kpndomain.com when DNS exists (guide §8).
FRONTEND_URL=http://172.28.80.50:3150
# Other addresses that may open the app (comma-separated). After the DNS switch, keep the IP here.
CORS_ORIGINS=
# Production is plain HTTP until TLS (guide §11): browsers refuse Secure cookies over
# HTTP. The backend refuses this line once FRONTEND_URL is https - delete it then.
SESSION_COOKIE_SECURE=false

# --- DWS Hub sign-in (PRODUCTION Hub) ---
DWS_HUB_URL=https://dwshub.kpndomain.com
DWS_HUB_CLIENT_ID=astar-erp
# Byte-exact as registered in the Hub. Day one:
DWS_HUB_REDIRECT_URI=http://172.28.80.50:3150/api/auth/sso/callback
# Empty = any Hub account may request access (an ERP admin still approves it).
DWS_HUB_ALLOWED_EMAIL_DOMAINS=

# --- Recovery administrator (always keeps the Administrator role; IP Security) ---
MATTHEW_EMAIL=matthew.chiu@kpn-corp.com

# --- Google Sheets: the PRODUCTION spreadsheets ---
# Empty SHEET_ID_* / SHEETS_SERVICE_ACCOUNT_EMAIL = the production spreadsheets and
# their own service accounts (backend/config/dataSources.js). They only fill
# Admin -> Sheets Config on the first start; manage them there afterwards.
# NEVER set SHEETS_COPIES_ONLY here, and never run a second instance against these
# sheets: the sync writes back (match IDs, vessel links, user edits).
SHEETS_SERVICE_ACCOUNT_EMAIL=

# --- Google sign-in ---
# Off over HTTP: Google accepts only https:// origins. Users sign in with DWS Hub
# (their ERP account links by email). Set GOOGLE_CLIENT_ID after TLS (guide §11).
GOOGLE_CLIENT_ID=

# --- ApsaraDB RDS (schema migrations; the app reads it from Phase 1) ---
# Owner account from guide §3, no password here (secrets.production.env).
MIGRATION_DATABASE_URL=postgres://astar_erp_owner@pgm-d9jn3khh0b3907w4.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/astar_erp?sslmode=disable

# --- Activity report e-mail (optional; the old server's values) ---
# USER_ACTIVITY_REPORT_TO=
