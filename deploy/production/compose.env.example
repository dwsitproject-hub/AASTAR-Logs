# /opt/astar-erp/.env on each production server - read by Docker Compose itself
# (not by the app). Copy, then set ASTAR_SUBNET to the line
# "suggested subnet for astar-erp_net" printed by preflight.sh on THAT server.
ASTAR_SUBNET=FILL_FROM_PREFLIGHT

# Only if the preflight reported the port taken (use the free one it printed, and the
# same number everywhere the guide's §1 lists):
# ASTAR_API_BIND=172.28.80.51:4150      # BE server
# ASTAR_WEB_BIND=172.28.80.50:3150      # FE server
# ASTAR_BACKEND_URL=http://172.28.80.51:4150
