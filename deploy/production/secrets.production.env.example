# PRODUCTION backend secrets. Copy to /opt/astar-erp/secrets.production.env,
# chmod 600, fill with nano on the server (guide §7). Never commit the copy.
# release.sh refuses to start while a FILL_ value is left.

# 48+ random characters each, all three different:  openssl rand -base64 48
JWT_SECRET=FILL_RANDOM_48
SESSION_AUDIT_HMAC_KEY=FILL_RANDOM_48
PASSWORD_AUDIT_HMAC_KEY=FILL_RANDOM_48

# astar_erp_owner password, inside the single quotes, as is (no URL encoding; the
# quotes keep a $ literal). The only character it cannot contain is a single quote.
MIGRATION_DATABASE_PASSWORD='FILL_OWNER_PASSWORD'

# --- Optional: live vessel positions, the activity e-mail ---
# AISSTREAM_API_KEY=
# SMTP_URL=
