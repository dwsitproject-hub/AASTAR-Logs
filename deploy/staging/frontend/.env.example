# STAGING frontend settings (deploy/staging/frontend/.env).  cp .env.example .env

# Backend server: private address and port from deploy/staging/backend.
BACKEND_URL=http://172.28.92.57:4150
# Port users open on this server. Must match FRONTEND_URL and DWS_HUB_REDIRECT_URI on the backend.
FRONTEND_HOST_PORT=3150

# DWS Hub SDK (page views, JS errors, bug reports for Sentinel), from the STAGING Hub:
# Hub Admin -> Applications -> Astar ERP (Staging) -> SDK. Empty = build without the SDK.
VITE_HUB_SDK_KEY=
VITE_HUB_SDK_URL=http://test-dwshub.kpndomain.com
