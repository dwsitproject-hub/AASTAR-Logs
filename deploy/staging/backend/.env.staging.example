# STAGING backend settings (deploy/staging/backend/.env.staging).
#   cp .env.staging.example .env.staging && chmod 600 .env.staging
# Replace every placeholder value; deploy.sh refuses to start while one is left.

# --- Sessions ---
# 48+ random characters:  openssl rand -base64 48
JWT_SECRET=REPLACE_ME
SESSION_AUDIT_HMAC_KEY=REPLACE_ME
# Exactly the address users open (no trailing slash). Also the CORS / WebSocket origin.
FRONTEND_URL=http://172.28.92.56:3150
# Staging is plain HTTP: browsers refuse Secure cookies there. Remove this line once
# staging is served over HTTPS (the backend refuses it with an https FRONTEND_URL).
SESSION_COOKIE_SECURE=false

# --- DWS Hub sign-in (staging Hub, strict OIDC: code + PKCE, JWKS-verified ID token) ---
DWS_HUB_URL=http://test-dwshub.kpndomain.com
DWS_HUB_CLIENT_ID=astar-erp-staging
DWS_HUB_REDIRECT_URI=http://172.28.92.56:3150/api/auth/sso/callback
# Empty = any Hub account may request access (an ERP admin still approves it).
DWS_HUB_ALLOWED_EMAIL_DOMAINS=

# --- Recovery administrator (Admin -> IP Security, activity report) ---
# The account with this email always keeps the administrator role.
MATTHEW_EMAIL=matthew.chiu@kpn-corp.com

# --- Google Sheets ---
# These only fill Admin -> Sheets Config the first time; after that, manage them there.
# Staging uses copies of the production spreadsheets (SHEETS_COPIES_ONLY is set in compose).
SHEETS_SERVICE_ACCOUNT_EMAIL=aastar-logs-staging@production-plan-512202.iam.gserviceaccount.com
SHEET_ID_AASTAR_SALES=14BT8bSytOhyY_Px8rYCXAldWt3NiR3O62AgZLDoeYaM
SHEET_ID_GR=1BqYTF8VrBBESM1K7iSn6GE7Yn8EqCUdm-1hGx0zCpQw
SHEET_ID_VESSEL=1O1j0sWQfObnKm0ytNu9fo18rFdM0c-yUcHQz4bQr3sM
SHEET_ID_STOCK=108OiwtG0UanA1LuPlKf3eC6UtEDDW-tKexkdyFyBpy8
SHEET_ID_SHIPMENT_DETAILS=none
SHEET_ID_TPG_OPERATIONS=154uDp10YJAd-zfhWDJU5pc44tOVjvhf86cx93li7Pvg

# --- ApsaraDB RDS for PostgreSQL (schema migrations; the app reads it from Phase 1) ---
# Owner account from the guide, step 4. sslmode=disable while RDS SSL is off;
# with SSL on: ?sslmode=verify-full&sslrootcert=/app/secrets/rds-ca.pem (mount the CA).
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
MIGRATION_DATABASE_URL=postgres://astar_erp_owner:REPLACE_ME@pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/astar_erp?sslmode=disable

# --- Optional ---
# Live vessel positions (aisstream.io); without a key the map uses public sources only.
# AISSTREAM_API_KEY=
# Activity report e-mail
# SMTP_URL=
# USER_ACTIVITY_REPORT_TO=
