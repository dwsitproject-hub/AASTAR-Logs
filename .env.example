# Local Docker stack (docker-compose.yml). Copy to .env — it is gitignored.

# >= 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# One-click sign-in on the login page for this seeded account (local stack only;
# the backend refuses to start with it when NODE_ENV=production). Leave empty to disable.
LOCAL_DEV_LOGIN_EMAIL=

# Host ports (both bound to 127.0.0.1)
FRONTEND_PORT=8090
POSTGRES_PORT=55440
POSTGRES_PASSWORD=erp_local_only

# Optional real sign-in methods (see backend/.env.example)
# GOOGLE_CLIENT_ID=
# DWS_HUB_URL=https://dwshub.kpndomain.com
# DWS_HUB_CLIENT_ID=astar-erp
# DWS_HUB_REDIRECT_URI=http://localhost:8090/api/auth/sso/callback
# DWS_HUB_ALLOWED_EMAIL_DOMAINS=

# Optional frontend build args
# VITE_HUB_SDK_KEY=
# VITE_HUB_SDK_URL=https://dwshub.kpndomain.com
