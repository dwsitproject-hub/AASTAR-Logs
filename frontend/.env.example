# DWS Hub SDK (analytics, JS errors, bug reports for Sentinel).
# Copy the key from Hub Admin -> Applications -> (this app) -> SDK. Staging and production Hubs have different keys.
# Leave empty to build without the SDK.
VITE_HUB_SDK_KEY=
# Hub that serves the SDK script; must match the key's environment (HTTPS app -> HTTPS Hub).
VITE_HUB_SDK_URL=https://dwshub.kpndomain.com
# Release reported to Sentinel. Defaults to `git rev-parse --short HEAD`, else package version + build date.
# VITE_GIT_SHA=
# VITE_HUB_SDK_DEBUG=true
