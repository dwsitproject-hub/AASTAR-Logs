PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
FRONTEND_URL=https://yourdomain.com
DB_PATH=./data/erp.db
SERVICE_ACCOUNTS_DIR=./service-accounts

# --- DWS Hub single sign-on (strict OIDC: authorization code + PKCE, JWKS-verified ID token) ---
# Hub base URL; discovery is read from <DWS_HUB_URL>/api/sso/.well-known/openid-configuration
DWS_HUB_URL=https://dwshub.kpndomain.com
# Hub Admin -> Applications -> this app: sso_mode=oidc, oauth_client_id, oidc_redirect_uris
DWS_HUB_CLIENT_ID=astar-erp
# Must exactly match one of the app's oidc_redirect_uris in the Hub
DWS_HUB_REDIRECT_URI=https://yourdomain.com/api/auth/sso/callback
# Optional: comma-separated email domains allowed to sign in through the Hub (empty = any Hub user)
DWS_HUB_ALLOWED_EMAIL_DOMAINS=kpn-corp.com
# Optional: DWS_HUB_SSO_ENABLED=0 hides the button without removing the settings
# Optional: DWS_HUB_SESSION_REMEMBER=1 keeps Hub sessions for REMEMBER_SESSION_MAX_AGE_SECONDS (default 8h sessions)
# Optional: DWS_HUB_SCOPE=openid profile email
# Optional: DWS_HUB_LOGIN_RATE_LIMIT=300 (per IP per 15 minutes; raise for large offices behind one NAT IP)

# --- Local stacks only ---
# One-click sign-in for this seeded account (npm run seed:admin -- <email>). The server refuses
# to start if it is set with NODE_ENV=production. Never set it on staging or production.
# LOCAL_DEV_LOGIN_EMAIL=

# --- Network (3-server platform, TECHNICAL-DESIGN.md §4) ---
# Address to listen on: 127.0.0.1 on a single host; the backend private IP when Nginx runs on the frontend server
HOST=127.0.0.1
# Reverse proxies in front of Express whose X-Forwarded-For is trusted (1 = Nginx; 2 = SLB + Nginx without real_ip)
TRUST_PROXY_HOPS=1

# --- PostgreSQL (ApsaraDB RDS for PostgreSQL 18) ---
# Runtime connection (application account) — used from Phase 1 onwards
# DATABASE_URL=postgres://astar_erp_app_login:<password>@<rds-host>:5432/erp?sslmode=verify-full&sslrootcert=/opt/astar-erp/secrets/rds-ca.pem
# Schema migrations (owner account) — `npm run db:migrate`, `npm run db:status`
# MIGRATION_DATABASE_URL=postgres://astar_erp_owner@<rds-host>:5432/astar_erp?sslmode=verify-full&sslrootcert=/opt/astar-erp/secrets/rds-ca.pem
# Password separately (no URL encoding needed):
# MIGRATION_DATABASE_PASSWORD='<password>'
