{
  "name": "erp-backend",
  "version": "1.0.0",
  "description": "ERP Backend API with Google Sheets cache",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --require ./test/setupEnv.js --test test/*.test.js",
    "activity:report": "node scripts/send-user-activity-report.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:status": "node scripts/db-migrate.js status"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^9.15.1",
    "googleapis": "^176.0.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "geoip-lite": {
      "ip-address": "^10.6.0"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.4.1": true
  },
  "engines": {
    "node": ">=22"
  }
}
